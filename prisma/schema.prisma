generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  DRAFT
  GENERATING
  READY_FOR_REVIEW
  SCHEDULED
  RUNNING
  COMPLETED
  PAUSED
  FAILED
}

enum RecipientStatus {
  NEW
  GENERATING
  READY
  SCHEDULED
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum AiProviderChoice {
  OPENROUTER
  MOCK
}

enum EmailProviderChoice {
  GMAIL
  MOCK
  SMTP
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SendKind {
  CAMPAIGN
  TEST
}

enum SendStatus {
  SENDING
  SENT
  FAILED
}

enum EmailProviderType {
  GMAIL
  MICROSOFT
  MOCK
  SMTP
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

enum LogCategory {
  CSV_IMPORT
  AI_GENERATION
  AI_ERROR
  EMAIL_SEND
  EMAIL_FAILURE
  RETRY
  AUTH
  CAMPAIGN_STATE
  RESEARCH
}

enum CampaignKind {
  STANDARD
  COMPANY
  BULK
}

/// Where a bulk-outreach recipient's address came from.
enum EmailSource {
  CSV
  WEBSITE
  MANUAL
  NOT_FOUND
}

enum SubjectMode {
  FIXED
  AI
}

enum ResearchProviderChoice {
  LIVE
  MOCK
}

enum ResearchStatus {
  NOT_STARTED
  SEARCHING
  COMPLETED
  PARTIAL
  FAILED
}

enum ContactDiscoveryStatus {
  NOT_FOUND
  FOUND
  VERIFIED
  NEEDS_REVIEW
}

enum ContractStatus {
  FOUND
  NOT_FOUND
}

enum DraftStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum EmailConfidence {
  HIGH
  MEDIUM
  LOW
}

enum SourceType {
  OFFICIAL
  GOVERNMENT
  THIRD_PARTY
  USER_SUPPLIED
}

enum ContactOrigin {
  IMPORTED
  DISCOVERED
}

enum AiLogStatus {
  SUCCESS
  RETRY
  FAILED
}

model User {
  id                        String                  @id @default(cuid())
  email                     String                  @unique
  name                      String?
  passwordHash              String                  @map("password_hash")
  /// Provider choices from Settings; null falls back to AI_PROVIDER / EMAIL_PROVIDER. Ignored in production.
  aiProvider                AiProviderChoice?       @map("ai_provider")
  emailProvider             EmailProviderChoice?    @map("email_provider")
  researchProvider          ResearchProviderChoice? @map("research_provider")
  /// The one master email body used for every researched company.
  companyEmailBody          String?                 @map("company_email_body")
  companyEmailBodyUpdatedAt DateTime?               @map("company_email_body_updated_at")
  /// Credit system: $1 = 5 campaign runs
  campaignCredits           Int                     @default(5) @map("campaign_credits")
  campaignsUsed             Int                     @default(0) @map("campaigns_used")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")

  sessions          Session[]
  emailAccounts     EmailAccount[]
  contacts          Contact[]
  campaigns         Campaign[]
  activityLogs      ActivityLog[]
  companies         Company[]
  senderProfiles    SenderProfile[]
  campaignTemplates CampaignTemplate[]
  upiPayments       UpiPayment[]
  documents         Document[]
  signatureRequests SignatureRequest[]
  apiKeys           ApiKey[]

  @@map("users")
}

/// External API keys for other applications to send mail. Raw key is shown once; only the hash is stored.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  /// SHA-256 of the raw key (srots_...).
  keyHash    String    @unique @map("key_hash")
  /// First characters of the raw key for display in Settings.
  keyPrefix  String    @map("key_prefix")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model UpiPayment {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  amount         Float    @default(85.0)
  creditsGranted Int      @default(5) @map("credits_granted")
  utr            String   @map("utr")
  screenshotData String?  @map("screenshot_data")
  status         String   @default("VERIFIED")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([utr])
  @@map("upi_payments")
}

model Session {
  /// SHA-256 hash of the session token; the raw token only lives in the cookie.
  id        String   @id
  userId    String   @map("user_id")
  csrfToken String   @map("csrf_token")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailAccount {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  provider        EmailProviderType
  email           String
  displayName     String?           @map("display_name")
  /// AES-256-GCM encrypted, never returned to the client.
  accessTokenEnc  String?           @map("access_token_enc")
  /// AES-256-GCM encrypted, never returned to the client.
  refreshTokenEnc String?           @map("refresh_token_enc")
  tokenExpiresAt  DateTime?         @map("token_expires_at")
  scope           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([userId, provider])
  @@map("email_accounts")
}

model Contact {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  /// Null only for bulk-outreach rows whose address has not been found or approved yet.
  email             String?
  companyName       String?  @map("company_name")
  companyWebsite    String?  @map("company_website")
  toPersonName      String?  @map("to_person_name")
  fromPersonName    String?  @map("from_person_name")
  purposeReason     String?  @map("purpose_reason")
  tone              String?
  keyPoints         String?  @map("key_points")
  context           String?
  subjectContext    String?  @map("subject_context")
  additionalDetails String?  @map("additional_details")
  /// A ready-written email body from the CSV; the AI only lightly adapts it per recipient.
  emailBody         String?  @map("email_body")
  /// Every CSV column that was not mapped to a named field, keyed by its original header.
  customFields      Json?    @map("custom_fields")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignContacts CampaignContact[]

  @@unique([userId, email])
  @@index([email])
  @@map("contacts")
}

model Campaign {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  campaignName   String         @map("campaign_name")
  kind           CampaignKind   @default(STANDARD)
  description    String?
  emailTemplate  String?        @map("email_template")
  aiPrompt       String?        @map("ai_prompt")
  targetWords    Int?           @map("target_words")
  status         CampaignStatus @default(DRAFT)
  promptVersion  Int            @default(1) @map("prompt_version")
  totalContacts  Int            @default(0) @map("total_contacts")
  generatedCount Int            @default(0) @map("generated_count")
  approvedCount  Int            @default(0) @map("approved_count")
  sentCount      Int            @default(0) @map("sent_count")
  failedCount    Int            @default(0) @map("failed_count")

  generationPaused       Boolean   @default(false) @map("generation_paused")
  generationPausedReason String?   @map("generation_paused_reason")
  senderAccountId        String?   @map("sender_account_id")
  sendConfirmedAt        DateTime? @map("send_confirmed_at")
  sendStartedAt          DateTime? @map("send_started_at")
  completedAt            DateTime? @map("completed_at")
  cancelledAt            DateTime? @map("cancelled_at")
  nextBatchAt            DateTime? @map("next_batch_at")
  batchDelayMs           Int?      @map("batch_delay_ms")
  pausedReason           String?   @map("paused_reason")
  scheduleStartAt        DateTime? @map("schedule_start_at")
  sendIntervalSec        Int?      @map("send_interval_sec")
  scheduleTimezone       String?   @map("schedule_timezone")

  /// Bulk outreach: ONE body for every row, kept exactly; only placeholders are replaced.
  bulkBody            String?      @map("bulk_body")
  subjectMode         SubjectMode? @map("subject_mode")
  subjectTemplate     String?      @map("subject_template")
  aiPersonalization   Boolean      @default(false) @map("ai_personalization")
  aiInstructions      String?      @map("ai_instructions")
  productLineFallback String?      @map("product_line_fallback")
  senderProfileId     String?      @map("sender_profile_id")
  /// Sender values frozen when emails are generated, so later profile edits never change drafts.
  senderSnapshot      Json?        @map("sender_snapshot")
  templateId          String?      @map("template_id")
  /// Copied on every email of the campaign (one email per recipient, same CC on each).
  ccEmails            String[]     @default([]) @map("cc_emails")
  /// One file attached, unchanged, to every email of the campaign.
  attachmentName      String?      @map("attachment_name")
  attachmentType      String?      @map("attachment_type")
  attachmentSize      Int?         @map("attachment_size")
  attachmentData      Bytes?       @map("attachment_data")
  /// Local path when the file is kept on disk instead of in the database.
  attachmentPath      String?      @map("attachment_path")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderAccount    EmailAccount?           @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)
  senderProfile    SenderProfile?          @relation(fields: [senderProfileId], references: [id], onDelete: SetNull)
  template         CampaignTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  campaignContacts CampaignContact[]
  promptVersions   CampaignPromptVersion[]
  emailSends       EmailSend[]
  aiLogs           AiGenerationLog[]
  activityLogs     ActivityLog[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("campaigns")
}

model CampaignPromptVersion {
  id            String   @id @default(cuid())
  campaignId    String   @map("campaign_id")
  version       Int
  aiPrompt      String?  @map("ai_prompt")
  emailTemplate String?  @map("email_template")
  targetWords   Int?     @map("target_words")
  createdAt     DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, version])
  @@map("campaign_prompt_versions")
}

model CampaignContact {
  id                  String          @id @default(cuid())
  campaignId          String          @map("campaign_id")
  contactId           String          @map("contact_id")
  status              RecipientStatus @default(NEW)
  approvalStatus      ApprovalStatus  @default(PENDING) @map("approval_status")
  currentEmailId      String?         @unique @map("current_email_id")
  queuedForGeneration Boolean         @default(false) @map("queued_for_generation")
  generationAttempts  Int             @default(0) @map("generation_attempts")
  generationError     String?         @map("generation_error")
  errorMessage        String?         @map("error_message")
  retryCount          Int             @default(0) @map("retry_count")
  sentAt              DateTime?       @map("sent_at")
  providerMessageId   String?         @map("provider_message_id")
  lockedAt            DateTime?       @map("locked_at")
  nextAttemptAt       DateTime?       @map("next_attempt_at")
  scheduledAt         DateTime?       @map("scheduled_at")
  /// Set for rows of a COMPANY campaign (sent from an approved company email draft).
  companyId           String?         @map("company_id")
  emailDraftId        String?         @map("email_draft_id")
  /// Bulk outreach: where the address came from; WEBSITE/MANUAL addresses need emailApprovedAt.
  emailSource         EmailSource?    @map("email_source")
  emailSourceUrl      String?         @map("email_source_url")
  /// Best public address found by research (only offered when the CSV had no email).
  discoveredEmail     String?         @map("discovered_email")
  emailApprovedAt     DateTime?       @map("email_approved_at")
  researchCompanyId   String?         @map("research_company_id")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  campaign        Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact         Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company         Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  researchCompany Company?          @relation("BulkResearch", fields: [researchCompanyId], references: [id], onDelete: SetNull)
  emailDraft      EmailDraft?       @relation(fields: [emailDraftId], references: [id], onDelete: SetNull)
  currentEmail    GeneratedEmail?   @relation("CurrentEmail", fields: [currentEmailId], references: [id], onDelete: SetNull)
  emails          GeneratedEmail[]  @relation("EmailVersions")
  sends           EmailSend[]
  aiLogs          AiGenerationLog[]

  @@unique([campaignId, contactId])
  @@unique([campaignId, companyId])
  @@index([companyId])
  @@index([researchCompanyId])
  @@index([campaignId])
  @@index([contactId])
  @@index([campaignId, status])
  @@index([queuedForGeneration, status])
  @@index([status, scheduledAt])
  @@map("campaign_contacts")
}

model GeneratedEmail {
  id                String   @id @default(cuid())
  campaignContactId String   @map("campaign_contact_id")
  version           Int
  subject           String
  body              String
  model             String
  promptVersion     Int      @map("prompt_version")
  /// Exact prompt sent to the model, so later prompt edits never change history.
  promptSnapshot    String   @map("prompt_snapshot")
  editedByUser      Boolean  @default(false) @map("edited_by_user")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  campaignContact CampaignContact   @relation("EmailVersions", fields: [campaignContactId], references: [id], onDelete: Cascade)
  currentFor      CampaignContact?  @relation("CurrentEmail")
  sends           EmailSend[]
  aiLogs          AiGenerationLog[]

  @@unique([campaignContactId, version])
  @@map("generated_emails")
}

model EmailSend {
  id                String            @id @default(cuid())
  campaignId        String            @map("campaign_id")
  campaignContactId String?           @map("campaign_contact_id")
  generatedEmailId  String?           @map("generated_email_id")
  kind              SendKind
  status            SendStatus
  provider          EmailProviderType
  fromEmail         String            @map("from_email")
  toEmail           String            @map("to_email")
  ccEmails          String[]          @default([]) @map("cc_emails")
  subject           String
  body              String
  attempt           Int               @default(1)
  providerMessageId String?           @map("provider_message_id")
  errorMessage      String?           @map("error_message")
  sentAt            DateTime?         @map("sent_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignContact CampaignContact? @relation(fields: [campaignContactId], references: [id], onDelete: SetNull)
  generatedEmail  GeneratedEmail?  @relation(fields: [generatedEmailId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([sentAt])
  @@index([campaignId, kind])
  @@index([campaignContactId])
  @@map("email_sends")
}

model AiGenerationLog {
  id                String      @id @default(cuid())
  campaignId        String      @map("campaign_id")
  campaignContactId String?     @map("campaign_contact_id")
  generatedEmailId  String?     @map("generated_email_id")
  status            AiLogStatus
  model             String
  promptVersion     Int         @map("prompt_version")
  prompt            String
  attempt           Int         @default(1)
  httpStatus        Int?        @map("http_status")
  errorMessage      String?     @map("error_message")
  latencyMs         Int?        @map("latency_ms")
  promptTokens      Int?        @map("prompt_tokens")
  completionTokens  Int?        @map("completion_tokens")
  generatedAt       DateTime    @default(now()) @map("generation_timestamp")

  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignContact CampaignContact? @relation(fields: [campaignContactId], references: [id], onDelete: SetNull)
  generatedEmail  GeneratedEmail?  @relation(fields: [generatedEmailId], references: [id], onDelete: SetNull)

  @@index([campaignId, generatedAt])
  @@index([campaignContactId])
  @@map("ai_generation_logs")
}

model ActivityLog {
  id         String      @id @default(cuid())
  userId     String?     @map("user_id")
  campaignId String?     @map("campaign_id")
  category   LogCategory
  level      LogLevel    @default(INFO)
  message    String
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

model Company {
  id             String                  @id @default(cuid())
  userId         String                  @map("user_id")
  importBatchId  String?                 @map("import_batch_id")
  /// Working values (taken from the upload, trimmed only). The untouched upload is in originalRow.
  name           String
  website        String?
  description    String?
  contactName    String?                 @map("contact_name")
  /// Exactly as typed in the uploaded file (never lowercased or corrected).
  knownEmail     String?                 @map("known_email")
  subject        String?
  notes          String?
  /// The user's own email body: the master text for this company's email.
  originalBody   String                  @map("original_body")
  /// Every uploaded cell exactly as it was, keyed by original header.
  /// json (not jsonb) keeps the uploaded column order and text byte-for-byte.
  originalRow    Json                    @map("original_row") @db.Json
  researchStatus ResearchStatus          @default(NOT_STARTED) @map("research_status")
  contractStatus ContractStatus?         @map("contract_status")
  contactStatus  ContactDiscoveryStatus? @map("contact_status")
  researchQueued Boolean                 @default(false) @map("research_queued")
  lockedAt       DateTime?               @map("locked_at")
  researchError  String?                 @map("research_error")
  researchedAt   DateTime?               @map("researched_at")
  /// Research record created for a bulk-outreach campaign; hidden from the Companies list.
  campaignOnly   Boolean                 @default(false) @map("campaign_only")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  research         CompanyResearch?
  sources          CompanySource[]
  contracts        Contract[]
  contacts         CompanyContact[]
  draft            EmailDraft?
  logs             ResearchLog[]
  campaignContacts CampaignContact[]
  bulkRows         CampaignContact[] @relation("BulkResearch")

  @@index([userId, createdAt])
  @@index([researchQueued, researchStatus])
  @@map("companies")
}

model CompanyResearch {
  id                 String         @id @default(cuid())
  companyId          String         @unique @map("company_id")
  status             ResearchStatus
  industry           String?
  summary            String?
  relevantDepartment String?        @map("relevant_department")
  procurementInfo    String?        @map("procurement_info")
  vendorRequirements String?        @map("vendor_requirements")
  /// Source URLs the summary fields were taken from.
  summarySources     Json?          @map("summary_sources")
  model              String?
  researchedAt       DateTime       @default(now()) @map("researched_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_research")
}

model CompanySource {
  id            String     @id @default(cuid())
  companyId     String     @map("company_id")
  url           String
  title         String?
  sourceType    SourceType @map("source_type")
  httpStatus    Int?       @map("http_status")
  robotsAllowed Boolean    @default(true) @map("robots_allowed")
  excerpt       String?
  fetchedAt     DateTime   @default(now()) @map("fetched_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, url])
  @@map("company_sources")
}

model Contract {
  id                 String   @id @default(cuid())
  companyId          String   @map("company_id")
  title              String
  reference          String?
  department         String?
  publicationDate    String?  @map("publication_date")
  closingDate        String?  @map("closing_date")
  requirementSummary String?  @map("requirement_summary")
  status             String?
  sourceUrl          String   @map("source_url")
  sourceTitle        String?  @map("source_title")
  discoveredAt       DateTime @default(now()) @map("discovered_at")
  createdAt          DateTime @default(now()) @map("created_at")

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drafts  EmailDraft[]

  @@index([companyId])
  @@map("contracts")
}

model CompanyContact {
  id             String                 @id @default(cuid())
  companyId      String                 @map("company_id")
  /// Exactly as published (or as typed in the upload).
  email          String
  contactName    String?                @map("contact_name")
  department     String?
  emailType      String                 @map("email_type")
  sourceUrl      String?                @map("source_url")
  sourceTitle    String?                @map("source_title")
  sourceType     SourceType             @map("source_type")
  confidence     EmailConfidence
  status         ContactDiscoveryStatus
  origin         ContactOrigin
  isSelected     Boolean                @default(false) @map("is_selected")
  discoveredAt   DateTime               @default(now()) @map("discovered_at")
  verifiedAt     DateTime?              @map("verified_at")
  userApprovedAt DateTime?              @map("user_approved_at")
  /// Rejected by the user: never selected or sent to, and stays rejected when research runs again.
  rejectedAt     DateTime?              @map("rejected_at")

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drafts  EmailDraft[]

  @@unique([companyId, email])
  @@map("company_contacts")
}

model EmailDraft {
  id               String      @id @default(cuid())
  companyId        String      @unique @map("company_id")
  contactId        String?     @map("contact_id")
  contractId       String?     @map("contract_id")
  originalBody     String      @map("original_body")
  generatedSubject String?     @map("generated_subject")
  generatedBody    String?     @map("generated_body")
  editedByUser     Boolean     @default(false) @map("edited_by_user")
  status           DraftStatus @default(DRAFT)
  error            String?
  model            String?
  campaignId       String?     @map("campaign_id")
  approvedAt       DateTime?   @map("approved_at")
  rejectedAt       DateTime?   @map("rejected_at")
  sentAt           DateTime?   @map("sent_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact          CompanyContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contract         Contract?         @relation(fields: [contractId], references: [id], onDelete: SetNull)
  campaignContacts CampaignContact[]

  @@map("email_drafts")
}

model ResearchLog {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  query         String
  sourceUrl     String?  @map("source_url")
  result        String
  blockedReason String?  @map("blocked_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("research_logs")
}

model SenderProfile {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  label       String
  senderName  String   @map("sender_name")
  designation String?
  companyName String?  @map("company_name")
  email       String?
  phone       String?
  website     String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  templates CampaignTemplate[]

  @@index([userId])
  @@map("sender_profiles")
}

model CampaignTemplate {
  id                  String      @id @default(cuid())
  userId              String      @map("user_id")
  name                String
  body                String
  subjectMode         SubjectMode @default(FIXED) @map("subject_mode")
  subjectTemplate     String?     @map("subject_template")
  senderProfileId     String?     @map("sender_profile_id")
  aiPersonalization   Boolean     @default(false) @map("ai_personalization")
  aiInstructions      String?     @map("ai_instructions")
  productLineFallback String?     @map("product_line_fallback")
  ccEmails            String[]    @default([]) @map("cc_emails")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderProfile SenderProfile? @relation(fields: [senderProfileId], references: [id], onDelete: SetNull)
  campaigns     Campaign[]

  @@index([userId])
  @@map("campaign_templates")
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start")

  @@map("rate_limit_buckets")
}

/* ------------------------------------------------------------------------------------------ */
/* E-Signature                                                                                */
/* ------------------------------------------------------------------------------------------ */

enum SignatureRequestStatus {
  DRAFT
  SENT
  DELIVERED
  VIEWED
  IN_REVIEW
  PARTIALLY_SIGNED
  /// Every signer has signed; the final PDF is being generated.
  PENDING
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SignerStatus {
  /// Waiting for an earlier signer (sequential) or for the request to be sent.
  WAITING
  SENT
  DELIVERED
  VIEWED
  IN_REVIEW
  SIGNED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SignerRole {
  SIGNER
  APPROVER
  /// Receives the completed document only.
  CC
}

enum SigningOrder {
  SEQUENTIAL
  PARALLEL
}

enum SignatureFieldType {
  SIGNATURE
  INITIALS
  DATE
  NAME
  TEXT
}

enum SignatureMethod {
  DRAWN
  UPLOADED
  TYPED
}

enum NotificationKind {
  INVITATION
  REMINDER
  OTP
  VIEWED
  PARTIALLY_SIGNED
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
  DELIVERY_FAILED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum VerificationChannel {
  EMAIL
  SMS
}

enum VerificationOutcome {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
  LOCKED
}

model Document {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@index([userId, createdAt])
  @@map("documents")
}

/// One uploaded file. A DOCX keeps its original next to the converted PDF; signing always uses the PDF.
model DocumentVersion {
  id             String   @id @default(cuid())
  documentId     String   @map("document_id")
  version        Int
  originalName   String   @map("original_name")
  originalMime   String   @map("original_mime")
  originalSize   Int      @map("original_size")
  originalSha256 String   @map("original_sha256")
  /// Encrypted file under the e-sign storage directory; never exposed to clients.
  originalKey    String   @map("original_key")
  pdfSize        Int      @map("pdf_size")
  pdfSha256      String   @map("pdf_sha256")
  pdfKey         String   @map("pdf_key")
  pageCount      Int      @map("page_count")
  converted      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  document Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requests SignatureRequest[]

  @@unique([documentId, version])
  @@map("document_versions")
}

model SignatureRequest {
  id                String                 @id @default(cuid())
  userId            String                 @map("user_id")
  documentVersionId String                 @map("document_version_id")
  title             String
  subject           String
  message           String?
  status            SignatureRequestStatus @default(DRAFT)
  signingOrder      SigningOrder           @default(SEQUENTIAL) @map("signing_order")
  expiresAt         DateTime               @map("expires_at")
  reminderEveryDays Int                    @default(2) @map("reminder_every_days")
  senderName        String                 @map("sender_name")
  senderEmail       String                 @map("sender_email")
  senderCompany     String?                @map("sender_company")
  /// SHA-256 of the PDF the recipients were asked to sign, fixed when the request is sent.
  documentSha256    String?                @map("document_sha256")
  finalKey          String?                @map("final_key")
  finalSha256       String?                @map("final_sha256")
  finalSize         Int?                   @map("final_size")
  /// "electronic" or the PdfSigner that applied a certificate-based signature.
  signatureLevel    String                 @default("electronic") @map("signature_level")
  finalizeError     String?                @map("finalize_error")
  finalizeAttempts  Int                    @default(0) @map("finalize_attempts")
  sentAt            DateTime?              @map("sent_at")
  completedAt       DateTime?              @map("completed_at")
  rejectedAt        DateTime?              @map("rejected_at")
  expiredAt         DateTime?              @map("expired_at")
  cancelledAt       DateTime?              @map("cancelled_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  version       DocumentVersion        @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  recipients    SignatureRecipient[]
  fields        SignatureField[]
  signatures    Signature[]
  events        SignatureEvent[]
  auditLogs     AuditLog[]
  notifications EmailNotification[]
  certificate   CompletionCertificate?

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("signature_requests")
}

model SignatureRecipient {
  id                  String       @id @default(cuid())
  requestId           String       @map("request_id")
  name                String
  email               String
  role                SignerRole   @default(SIGNER)
  routingOrder        Int          @default(1) @map("routing_order")
  status              SignerStatus @default(WAITING)
  phone               String?
  requireSmsOtp       Boolean      @default(false) @map("require_sms_otp")
  /// SHA-256 of the link token; the raw token is only in the email and (encrypted) for reminders.
  tokenHash           String?      @unique @map("token_hash")
  tokenEnc            String?      @map("token_enc")
  tokenRevokedAt      DateTime?    @map("token_revoked_at")
  signingSessionHash  String?      @map("signing_session_hash")
  signingSessionUntil DateTime?    @map("signing_session_until")
  sentAt              DateTime?    @map("sent_at")
  deliveredAt         DateTime?    @map("delivered_at")
  viewedAt            DateTime?    @map("viewed_at")
  reviewedAt          DateTime?    @map("reviewed_at")
  consentAt           DateTime?    @map("consent_at")
  consentText         String?      @map("consent_text")
  consentIp           String?      @map("consent_ip")
  consentUserAgent    String?      @map("consent_user_agent")
  emailVerifiedAt     DateTime?    @map("email_verified_at")
  smsVerifiedAt       DateTime?    @map("sms_verified_at")
  signedAt            DateTime?    @map("signed_at")
  rejectedAt          DateTime?    @map("rejected_at")
  rejectReason        String?      @map("reject_reason")
  lastReminderAt      DateTime?    @map("last_reminder_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  request       SignatureRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fields        SignatureField[]
  signature     Signature?
  verifications VerificationAttempt[]
  notifications EmailNotification[]

  @@unique([requestId, email])
  @@index([requestId, routingOrder])
  @@map("signature_recipients")
}

/// Position on the page as seen by the viewer (rotation applied), normalised to 0..1 from the top-left.
model SignatureField {
  id          String             @id @default(cuid())
  requestId   String             @map("request_id")
  recipientId String             @map("recipient_id")
  type        SignatureFieldType
  page        Int
  x           Float
  y           Float
  width       Float
  height      Float
  required    Boolean            @default(true)
  label       String?
  /// Filled text for NAME / DATE / TEXT fields; set when the recipient signs.
  value       String?
  createdAt   DateTime           @default(now()) @map("created_at")

  request   SignatureRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recipient SignatureRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([requestId, page])
  @@map("signature_fields")
}

model Signature {
  id             String          @id @default(cuid())
  requestId      String          @map("request_id")
  recipientId    String          @unique @map("recipient_id")
  method         SignatureMethod
  /// PNG of the adopted signature, as placed on the document.
  image          Bytes
  typedName      String?         @map("typed_name")
  fontStyle      String?         @map("font_style")
  signerName     String          @map("signer_name")
  signerEmail    String          @map("signer_email")
  ip             String?
  userAgent      String?         @map("user_agent")
  /// SHA-256 of the PDF that was shown when signing.
  documentSha256 String          @map("document_sha256")
  createdAt      DateTime        @default(now()) @map("created_at")

  request   SignatureRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recipient SignatureRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("signatures")
}

/// Timeline of a request. Append-only (enforced by a database trigger).
model SignatureEvent {
  id          String   @id @default(cuid())
  requestId   String   @map("request_id")
  recipientId String?  @map("recipient_id")
  type        String
  message     String
  ip          String?
  userAgent   String?  @map("user_agent")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  request SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("signature_events")
}

/// Tamper-evident security log. Append-only (database trigger); each row hashes the previous row of the same scope.
model AuditLog {
  id          String   @id @default(cuid())
  seq         BigInt   @default(autoincrement())
  userId      String?  @map("user_id")
  requestId   String?  @map("request_id")
  documentId  String?  @map("document_id")
  recipientId String?  @map("recipient_id")
  action      String
  actor       String
  ip          String?
  userAgent   String?  @map("user_agent")
  details     Json?
  prevHash    String?  @map("prev_hash")
  hash        String
  createdAt   DateTime @default(now()) @map("created_at")

  request SignatureRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@unique([seq])
  @@index([requestId, seq])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model EmailNotification {
  id                String             @id @default(cuid())
  requestId         String             @map("request_id")
  recipientId       String?            @map("recipient_id")
  kind              NotificationKind
  toEmail           String             @map("to_email")
  subject           String
  status            NotificationStatus @default(QUEUED)
  attempts          Int                @default(0)
  lastError         String?            @map("last_error")
  providerMessageId String?            @map("provider_message_id")
  nextAttemptAt     DateTime?          @map("next_attempt_at")
  sentAt            DateTime?          @map("sent_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  request   SignatureRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recipient SignatureRecipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([requestId, createdAt])
  @@map("email_notifications")
}

model VerificationAttempt {
  id          String              @id @default(cuid())
  recipientId String              @map("recipient_id")
  channel     VerificationChannel
  /// HMAC-SHA256 of the one-time code; the code itself is never stored.
  codeHash    String              @map("code_hash")
  destination String
  outcome     VerificationOutcome @default(PENDING)
  attempts    Int                 @default(0)
  expiresAt   DateTime            @map("expires_at")
  verifiedAt  DateTime?           @map("verified_at")
  ip          String?
  userAgent   String?             @map("user_agent")
  createdAt   DateTime            @default(now()) @map("created_at")

  recipient SignatureRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@map("verification_attempts")
}

model CompletionCertificate {
  id             String   @id @default(cuid())
  requestId      String   @unique @map("request_id")
  storageKey     String   @map("storage_key")
  sha256         String
  size           Int
  originalSha256 String   @map("original_sha256")
  finalSha256    String   @map("final_sha256")
  createdAt      DateTime @default(now()) @map("created_at")

  request SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("completion_certificates")
}
